generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Config {
  id                  Int                 @id @default(autoincrement())
  nama_desa           String
  kode_desa           String?
  kode_pos            String?
  alamat              String?
  email               String?
  telepon             String?
  website             String?
  nama_kecamatan      String?
  nama_kabupaten      String?
  nama_propinsi       String?
  logo                String?
  lat                 String?
  lng                 String?
  zoom                Int?
  map_tipe            String?
  created_at          DateTime?           @default(now())
  updated_at          DateTime?           @updatedAt
  alamat_kantor       String?
  app_key             String?
  border              String?
  hp_kontak           String?
  jabatan_kontak      String?
  kantor_desa         String?
  kode_desa_bps       String?
  kode_kabupaten      String?
  kode_kecamatan      String?
  kode_propinsi       String?
  nama_kepala_camat   String?
  nama_kontak         String?
  nip_kepala_camat    String?
  nomor_operator      String?
  path                String?
  warna               String?
  hero_banner         String?
  artikel             Artikel[]
  dokumen             Dokumen[]
  kategori            Kategori[]
  keluarga            Keluarga[]
  kerjasama           Kerjasama[]
  komentar            Komentar[]
  lampiran_surat      LampiranSurat[]
  layanan_pelanggan   LayananPelanggan[]
  lembaga             Lembaga[]
  log_perubahan_surat LogPerubahanSurat[]
  log_surat           LogSurat[]
  log_tolak           LogTolak[]
  pamong              Pamong[]
  penduduk            Penduduk[]
  permohonan_surat    PermohonanSurat[]
  profil_desa         ProfilDesa[]
  ref_jabatan         RefJabatan[]
  ref_syarat_surat    RefSyaratSurat[]
  surat_format        SuratFormat[]
  users               User[]
  widget              Widget[]
  wilayah             Wilayah[]

  @@map("config")
}

model Wilayah {
  id         Int       @id @default(autoincrement())
  config_id  Int?
  dusun      String
  rw         String    @default("0")
  rt         String    @default("0")
  id_kepala  String?
  urut       Int       @default(0)
  urut_cetak Int       @default(0)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
  config     Config?   @relation(fields: [config_id], references: [id])

  @@index([config_id, dusun])
  @@index([config_id, rw])
  @@index([config_id, rt])
  @@map("wilayah")
}

model Pamong {
  id             Int         @id @default(autoincrement())
  config_id      Int?
  pamong_nama    String
  pamong_nik     String?
  pamong_niap    String?
  pamong_ttd     Int         @default(0)
  pamong_ub      Int         @default(0)
  pamong_status  Int         @default(1)
  status_pejabat Int         @default(0)
  id_pend        Int?
  jabatan_id     Int?
  gelar_depan    String?
  gelar_belakang String?
  tempatlahir    String?
  tanggallahir   DateTime?
  sex            Int?
  agama_id       Int?
  pendidikan_id  Int?
  no_hp          String?
  foto           String?
  media_sosial   String?
  urutan         Int         @default(0)
  created_at     DateTime?   @default(now())
  updated_at     DateTime?   @updatedAt
  logSurat       LogSurat[]
  jabatan        RefJabatan? @relation(fields: [jabatan_id], references: [id])
  config         Config?     @relation(fields: [config_id], references: [id])

  @@index([config_id, pamong_status])
  @@map("pamong")
}

model RefJabatan {
  id         Int       @id @default(autoincrement())
  config_id  Int?
  nama       String
  jenis      Int       @default(0)
  tupoksi    String?
  urut       Int       @default(0)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
  pamong     Pamong[]
  config     Config?   @relation(fields: [config_id], references: [id])

  @@index([config_id])
  @@map("ref_jabatan")
}

model ProfilDesa {
  id         Int       @id @default(autoincrement())
  config_id  Int?
  key        String
  value      String
  kategori   String    @default("lainnya")
  judul      String
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
  config     Config?   @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@unique([config_id, key])
  @@index([config_id, kategori])
  @@map("profil_desa")
}

model Lembaga {
  id         Int       @id @default(autoincrement())
  config_id  Int?
  nama       String
  singkatan  String?
  ketua      String?
  sekretaris String?
  alamat     String?
  keterangan String?
  urut       Int       @default(0)
  enabled    Int       @default(1)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
  config     Config?   @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@index([config_id])
  @@map("lembaga")
}

model LayananPelanggan {
  id         Int       @id @default(autoincrement())
  config_id  Int?
  nama       String
  kategori   String?
  kontak     String?
  url_form   String?
  keterangan String?
  enabled    Int       @default(1)
  created_at DateTime? @default(now())
  config     Config?   @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@index([config_id])
  @@map("layanan_pelanggan")
}

model Kerjasama {
  id              Int       @id @default(autoincrement())
  config_id       Int?
  judul           String
  mitra           String
  bidang          String?
  tanggal_mulai   DateTime?
  tanggal_selesai DateTime?
  nomor           String?
  keterangan      String?
  enabled         Int       @default(1)
  created_at      DateTime? @default(now())
  config          Config?   @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@index([config_id])
  @@map("kerjasama")
}

model Artikel {
  id             Int        @id @default(autoincrement())
  config_id      Int?
  judul          String
  isi            String
  slug           String?
  gambar         String?
  gambar1        String?
  gambar2        String?
  gambar3        String?
  dokumen        String?
  link_dokumen   String?
  tgl_upload     DateTime   @default(now())
  tgl_publish    DateTime?
  enabled        Int        @default(1)
  headline       Int        @default(0)
  slider         Int        @default(0)
  tipe           String     @default("dinamis")
  id_kategori    Int?
  id_user        Int?
  hit            Int        @default(0)
  boleh_komentar Int        @default(1)
  created_at     DateTime?  @default(now())
  updated_at     DateTime?  @updatedAt
  author         User?      @relation(fields: [id_user], references: [id])
  kategori       Kategori?  @relation(fields: [id_kategori], references: [id])
  config         Config?    @relation(fields: [config_id], references: [id])
  komentar       Komentar[]

  @@index([config_id, enabled, tgl_upload])
  @@index([slug])
  @@map("artikel")
}

model Kategori {
  id         Int        @id @default(autoincrement())
  config_id  Int?
  kategori   String
  slug       String?
  tipe       Int        @default(1)
  urut       Int        @default(0)
  enabled    Int        @default(1)
  parent_id  Int?
  created_at DateTime?  @default(now())
  artikel    Artikel[]
  parent     Kategori?  @relation("KategoriParent", fields: [parent_id], references: [id])
  children   Kategori[] @relation("KategoriParent")
  config     Config?    @relation(fields: [config_id], references: [id])

  @@map("kategori")
}

model Komentar {
  id         Int      @id @default(autoincrement())
  config_id  Int?
  id_artikel Int
  owner      String
  email      String?
  komentar   String
  enabled    Int      @default(1)
  tgl_upload DateTime @default(now())
  artikel    Artikel  @relation(fields: [id_artikel], references: [id], onDelete: Cascade)
  config     Config?  @relation(fields: [config_id], references: [id])

  @@index([id_artikel])
  @@map("komentar")
}

model User {
  id         Int       @id @default(autoincrement())
  config_id  Int?
  username   String    @unique
  password   String
  id_grup    Int?
  pamong_id  Int?
  email      String?
  active     Int       @default(1)
  nama       String
  phone      String?
  foto       String?
  last_login DateTime?
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
  artikel    Artikel[]
  config     Config?   @relation(fields: [config_id], references: [id])

  @@map("user")
}

model Widget {
  id         Int       @id @default(autoincrement())
  config_id  Int?
  judul      String
  isi        String
  enabled    Int       @default(1)
  urut       Int       @default(0)
  created_at DateTime? @default(now())
  config     Config?   @relation(fields: [config_id], references: [id])

  @@map("widget")
}

model Setting {
  id         Int       @id @default(autoincrement())
  key        String    @unique
  value      String
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  @@map("setting")
}

model MediaSosial {
  id        Int    @id @default(autoincrement())
  config_id Int?
  nama      String
  url       String
  ikon      String
  enabled   Int    @default(1)

  @@map("media_sosial")
}

model Galery {
  id         Int       @id @default(autoincrement())
  config_id  Int?
  nama       String
  parent_id  Int?
  enabled    Int       @default(1)
  slider     Int       @default(0)
  urut       Int       @default(0)
  created_at DateTime? @default(now())

  @@map("galery")
}

model Keluarga {
  id         Int        @id @default(autoincrement())
  config_id  Int?
  no_kk      String     @unique
  alamat     String?
  dusun      String?
  rw         String?
  rt         String?
  created_at DateTime?  @default(now())
  updated_at DateTime?  @updatedAt
  config     Config?    @relation(fields: [config_id], references: [id])
  anggota    Penduduk[] @relation("AnggotaKeluarga")

  @@index([config_id])
  @@map("keluarga")
}

model Penduduk {
  id                   Int               @id @default(autoincrement())
  config_id            Int?
  no_kk                String?
  nik                  String            @unique
  nama                 String
  sex                  Int?
  tempatlahir          String?
  tanggallahir         DateTime?
  agama_id             Int?
  pendidikan_kk_id     Int?
  pendidikan_sedang_id Int?
  pekerjaan_id         Int?
  status_kawin         Int?
  kk_level             Int?
  warganegara_id       Int?
  golongan_darah_id    Int?
  cacat_id             Int?
  cara_kb_id           Int?
  hamil                Int?
  ktp_el               Int?
  status_rekam         Int?
  status_dasar         Int?
  id_asuransi          Int?
  ayah_nik             String?
  nama_ayah            String?
  ibu_nik              String?
  nama_ibu             String?
  akta_lahir           String?
  dokumen_pasport      String?
  tanggal_akhir_paspor DateTime?
  dokumen_kitas        String?
  akta_perkawinan      String?
  tanggalperkawinan    DateTime?
  akta_perceraian      String?
  tanggalperceraian    DateTime?
  alamat_sekarang      String?
  suku                 String?
  tag_id_card          String?
  no_asuransi          String?
  lat                  String?
  lng                  String?
  created_at           DateTime?         @default(now())
  updated_at           DateTime?         @updatedAt
  foto                 String?
  dokumen              Dokumen[]
  logSurat             LogSurat[]
  asuransi             RefAsuransi?      @relation(fields: [id_asuransi], references: [id])
  status_dasar_ref     RefStatusDasar?   @relation(fields: [status_dasar], references: [id])
  cara_kb              RefCaraKB?        @relation(fields: [cara_kb_id], references: [id])
  cacat                RefCacat?         @relation(fields: [cacat_id], references: [id])
  golongan_darah       RefGolonganDarah? @relation(fields: [golongan_darah_id], references: [id])
  warganegara          RefWarganegara?   @relation(fields: [warganegara_id], references: [id])
  kk_level_ref         RefHubunganKK?    @relation(fields: [kk_level], references: [id])
  pekerjaan            RefPekerjaan?     @relation(fields: [pekerjaan_id], references: [id])
  pendidikan_sedang    RefPendidikan?    @relation("PendidikanSedang", fields: [pendidikan_sedang_id], references: [id])
  pendidikan_kk        RefPendidikan?    @relation("PendidikanKK", fields: [pendidikan_kk_id], references: [id])
  agama                RefAgama?         @relation(fields: [agama_id], references: [id])
  ibu                  Penduduk?         @relation("Ibu", fields: [ibu_nik], references: [nik])
  anak_ibu             Penduduk[]        @relation("Ibu")
  ayah                 Penduduk?         @relation("Ayah", fields: [ayah_nik], references: [nik])
  anak                 Penduduk[]        @relation("Ayah")
  keluarga             Keluarga?         @relation("AnggotaKeluarga", fields: [no_kk], references: [no_kk])
  config               Config?           @relation(fields: [config_id], references: [id])
  permohonanSurat      PermohonanSurat[]

  @@index([config_id, no_kk])
  @@index([config_id, nama])
  @@index([sex])
  @@map("penduduk")
}

model RefAgama {
  id         Int        @id @default(autoincrement())
  nama       String
  created_at DateTime?  @default(now())
  penduduk   Penduduk[]

  @@map("ref_agama")
}

model RefPendidikan {
  id              Int        @id @default(autoincrement())
  nama            String
  created_at      DateTime?  @default(now())
  penduduk_sedang Penduduk[] @relation("PendidikanSedang")
  penduduk_kk     Penduduk[] @relation("PendidikanKK")

  @@map("ref_pendidikan")
}

model RefPekerjaan {
  id         Int        @id @default(autoincrement())
  nama       String
  created_at DateTime?  @default(now())
  penduduk   Penduduk[]

  @@map("ref_pekerjaan")
}

model RefStatusKawin {
  id         Int       @id @default(autoincrement())
  nama       String
  created_at DateTime? @default(now())

  @@map("ref_status_kawin")
}

model RefHubunganKK {
  id         Int        @id @default(autoincrement())
  nama       String
  created_at DateTime?  @default(now())
  penduduk   Penduduk[]

  @@map("ref_hubungan_kk")
}

model RefWarganegara {
  id         Int        @id @default(autoincrement())
  nama       String
  created_at DateTime?  @default(now())
  penduduk   Penduduk[]

  @@map("ref_warganegara")
}

model RefGolonganDarah {
  id         Int        @id @default(autoincrement())
  nama       String
  created_at DateTime?  @default(now())
  penduduk   Penduduk[]

  @@map("ref_golongan_darah")
}

model RefCacat {
  id         Int        @id @default(autoincrement())
  nama       String
  created_at DateTime?  @default(now())
  penduduk   Penduduk[]

  @@map("ref_cacat")
}

model RefCaraKB {
  id         Int        @id @default(autoincrement())
  nama       String
  created_at DateTime?  @default(now())
  penduduk   Penduduk[]

  @@map("ref_cara_kb")
}

model RefStatusDasar {
  id         Int        @id @default(autoincrement())
  nama       String
  created_at DateTime?  @default(now())
  penduduk   Penduduk[]

  @@map("ref_status_dasar")
}

model RefAsuransi {
  id         Int        @id @default(autoincrement())
  nama       String
  created_at DateTime?  @default(now())
  penduduk   Penduduk[]

  @@map("ref_asuransi")
}

/// Referensi jenis syarat surat.
/// Dipakai oleh:
/// - M:N ke SuratFormat via JSON string `syarat_surat`
/// - 1:N ke Dokumen via kolom `id_syarat`
model RefSyaratSurat {
  id              Int       @id @default(autoincrement())
  config_id       Int?
  ref_syarat_nama String
  created_at      DateTime? @default(now())
  dokumen         Dokumen[]
  config          Config?   @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@unique([config_id, ref_syarat_nama])
  @@index([config_id])
  @@map("ref_syarat_surat")
}

/// Template/format surat (HTML atau RTF).
/// Kolom `syarat_surat` menyimpan JSON array id SyaratSurat
/// untuk relasi M:N tanpa tabel pivot.
model SuratFormat {
  id                       Int               @id @default(autoincrement())
  config_id                Int?
  nama                     String
  url_surat                String?
  kode_surat               String?
  lampiran                 String?
  kunci                    Int               @default(0)
  favorit                  Int               @default(0)
  jenis                    Int               @default(2)
  mandiri                  Int               @default(0)
  masa_berlaku             Int?
  satuan_masa_berlaku      String?
  qr_code                  Int               @default(0)
  qr_code_tte              Int               @default(0)
  logo_garuda              Int               @default(0)
  kecamatan                Int               @default(1)
  syarat_surat             String?
  template                 String?
  template_desa            String?
  form_isian               String?
  kode_isian               String?
  orientasi                String?
  ukuran                   String?
  margin                   String?
  margin_global            Int               @default(1)
  footer                   Int               @default(1)
  header                   Int               @default(1)
  format_nomor             String?
  format_nomor_global      Int               @default(1)
  sumber_penduduk_berulang Int               @default(0)
  created_at               DateTime?         @default(now())
  updated_at               DateTime?         @updatedAt
  logSurat                 LogSurat[]
  permohonanSurat          PermohonanSurat[]
  config                   Config?           @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@unique([config_id, url_surat])
  @@index([config_id, jenis])
  @@map("tweb_surat_format")
}

/// Template lampiran surat.
model LampiranSurat {
  id            Int       @id @default(autoincrement())
  config_id     Int?
  slug          String?
  nama          String
  jenis         Int       @default(2)
  template      String?
  template_desa String?
  status        Int       @default(1)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
  config        Config?   @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@unique([config_id, slug])
  @@index([config_id])
  @@map("lampiran_surat")
}

/// Log/catatan surat yang dicetak atau akan dicetak.
/// SoftDeletes: kolom `deleted_at` (Laravel-style, sesuai pola OpenSID).
///
/// Field snapshot (dipertahankan walau master diedit):
/// - nama_pamong, nama_jabatan (Pamong)
/// - nama_surat, kode_surat (SuratFormat)
model LogSurat {
  id                  Int          @id @default(autoincrement())
  config_id           Int?
  id_format_surat     Int?
  id_pend             Int?
  id_pamong           Int?
  id_user             Int?
  nama_pamong         String?
  nama_jabatan        String?
  nama_surat          String?
  kode_surat          String?
  tanggal             DateTime?
  bulan               String?
  tahun               String?
  no_surat            String?
  lampiran            String?
  nik_non_warga       String?
  nama_non_warga      String?
  keterangan          String?
  lokasi_arsip        String?
  urls_id             String?      @unique
  status              Int          @default(0)
  log_verifikasi      String?
  tte                 Int          @default(0)
  verifikasi_operator Int          @default(0)
  verifikasi_kades    Int          @default(0)
  verifikasi_sekdes   Int          @default(0)
  isi_surat           String?
  kecamatan           String?
  deleted_at          DateTime?
  pemohon             String?
  created_at          DateTime?    @default(now())
  updated_at          DateTime?    @updatedAt
  pamong              Pamong?      @relation(fields: [id_pamong], references: [id])
  penduduk            Penduduk?    @relation(fields: [id_pend], references: [id])
  formatSurat         SuratFormat? @relation(fields: [id_format_surat], references: [id])
  config              Config?      @relation(fields: [config_id], references: [id], onDelete: Cascade)
  tolak               LogTolak[]

  @@index([config_id, status])
  @@index([config_id, id_format_surat])
  @@index([config_id, id_pend])
  @@index([config_id, tanggal])
  @@index([config_id, no_surat])
  @@index([deleted_at])
  @@map("log_surat")
}

/// Alasan penolakan permohonan surat.
model LogTolak {
  id         Int       @id @default(autoincrement())
  config_id  Int?
  id_surat   Int
  nama       String?
  alasan     String?
  created_at DateTime? @default(now())
  created_by Int?
  logSurat   LogSurat  @relation(fields: [id_surat], references: [id], onDelete: Cascade)
  config     Config?   @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@index([config_id, id_surat])
  @@map("log_tolak")
}

/// Audit perubahan LogSurat.
model LogPerubahanSurat {
  id           Int       @id @default(autoincrement())
  config_id    Int?
  log_surat_id Int?
  field        String?
  nilai_lama   String?
  nilai_baru   String?
  created_at   DateTime? @default(now())
  created_by   Int?
  config       Config?   @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@index([config_id, log_surat_id])
  @@map("log_perubahan_surat")
}

/// Permohonan surat dari Layanan Mandiri warga.
///
/// Status workflow:
/// 0 = BELUM_LENGKAP
/// 1 = SEDANG_DIPERIKSA
/// 2 = MENUNGGU_TANDA_TANGAN
/// 3 = SIAP_DIAMBIL
/// 4 = SUDAH_DIAMBIL
/// 5 = DIBATALKAN
model PermohonanSurat {
  id          Int          @id @default(autoincrement())
  config_id   Int?
  id_pemohon  Int?
  id_surat    Int?
  isian_form  String?
  status      Int          @default(0)
  alasan      String?
  keterangan  String?
  no_hp_aktif String?
  syarat      String?
  no_antrian  String?
  created_at  DateTime?    @default(now())
  updated_at  DateTime?    @updatedAt
  surat       SuratFormat? @relation(fields: [id_surat], references: [id])
  pemohon     Penduduk?    @relation(fields: [id_pemohon], references: [id])
  config      Config?      @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@index([config_id, status])
  @@index([config_id, id_pemohon])
  @@index([config_id, id_surat])
  @@map("permohonan_surat")
}

/// Dokumen: bisa milik penduduk (id_pend) atau global.
/// Soft delete via kolom `deleted` (0/1, bukan SoftDeletes).
/// Self-reference untuk folder parent (`id_parent`).
model Dokumen {
  id                   Int             @id @default(autoincrement())
  config_id            Int?
  satuan               String?
  nama                 String
  enabled              Int             @default(1)
  tgl_upload           DateTime?       @default(now())
  id_pend              Int?
  id_syarat            Int?
  kategori_info_publik Int             @default(0)
  deleted              Int             @default(0)
  id_parent            Int?
  dok_warga            Int             @default(0)
  lokasi_arsip         String?
  attr                 String?
  tipe                 String?
  url                  String?
  tahun                String?
  kategori             Int             @default(1)
  created_at           DateTime?       @default(now())
  updated_at           DateTime?       @updatedAt
  parent               Dokumen?        @relation("DokumenParent", fields: [id_parent], references: [id])
  children             Dokumen[]       @relation("DokumenParent")
  syarat               RefSyaratSurat? @relation(fields: [id_syarat], references: [id])
  penduduk             Penduduk?       @relation(fields: [id_pend], references: [id])
  config               Config?         @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@index([config_id, deleted])
  @@index([config_id, id_pend])
  @@index([config_id, id_syarat])
  @@index([config_id, kategori])
  @@index([id_parent])
  @@map("dokumen")
}
